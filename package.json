{
  "name": "astro-test",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel \"/^dev:/\"",
    "dev:db": "turso dev --db-file dev.db",
    "dev:server": "astro dev --host",
    "build": "astro check && astro build --remote",
    "preview": "astro build && wrangler pages dev --port 4321",
    "test": "NODE_ENV=\"test\" npm run db:push && vitest --no-file-parallelism",
    "cf-typegen": "wrangler types",
    "gql-typegen": "graphql-codegen",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.6",
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^7.0.1",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-add-graphql": "^4.3.4",
    "@pothos/plugin-drizzle": "^0.20.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-hotkeys": "^0.22.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ably": "^2.30.0",
    "arctic": "^3.7.0",
    "astro": "^7.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-zod": "1.0.0-beta.9-e89174b",
    "graphql-yoga": "^6.0.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.66.0",
    "prettier-plugin-tailwind": "^2.2.12",
    "radix-themes-tw": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@parcel/watcher": "^2.6.0",
    "@tanstack/router-devtools": "^1.167.2",
    "@types/node": "^26.6.6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
